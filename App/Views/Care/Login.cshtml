@model Saffron.Models.LoginViewModel
<div class="row">
	<div class="col-sm-4 col-sm-offset-4">
		<h3>Sign in</h3>
		@if (!string.IsNullOrEmpty(Model.Error))
		{
			<div class="alert alert-danger" id="login-error">@Model.Error</div>
		}
		<form method="post" action="/care/login" id="login-form">
			<div class="form-group">
				<label for="username">Username</label>
				<input type="text" class="form-control" id="username" name="username" value="@Model.Username" autofocus>
			</div>
			<div class="form-group">
				<label for="password">Password</label>
				<input type="password" class="form-control" id="password" name="password">
			</div>
			<button type="submit" class="btn btn-primary">Sign in</button>
		</form>
	</div>
</div>
